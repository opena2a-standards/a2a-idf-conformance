{
  "$schema": "https://a2a-idf.opena2a.org/schemas/fixture-level-v1.json",
  "name": "levels/level-1-provider-url-space-in-host",
  "description": "Negative fixture: the DOMAIN_VERIFIED AgentCard whose provider.url is https://exa mple.com, with a space inside the host. A space is a forbidden host code point, so the URL does not parse. The domain attestation, the agentId and the DNS TXT record all name example.com. A conforming verifier MUST reject at the shape stage: provider.url yields no provider domain. A verifier whose URL parser returns the host with the space in it reports DOMAIN_MISMATCH and fails this fixture.",
  "spec": [
    {
      "id": "A2A-IDF",
      "ref": "https://github.com/a2aproject/A2A/pull/1496",
      "section": "§1 Agent Identity Verification Levels — Level 1 DNS Verification (provider.url with a forbidden host code point)"
    },
    {
      "id": "RFC 8032",
      "ref": "https://datatracker.ietf.org/doc/html/rfc8032",
      "section": "§7.1 (Ed25519 test keypairs)"
    },
    {
      "id": "WHATWG URL",
      "ref": "https://url.spec.whatwg.org/",
      "section": "host parsing (forbidden domain code points)"
    }
  ],
  "level": 1,
  "agentCard": {
    "name": "financial-advisor-agent",
    "provider": {
      "organization": "Example Corp",
      "url": "https://exa mple.com"
    },
    "capabilities": {
      "extensions": [
        {
          "uri": "https://a2a-protocol.org/extensions/agent-identity",
          "description": "Agent identity verification and trust signals",
          "required": false,
          "params": {
            "version": "1.0.0",
            "identityLevel": "DOMAIN_VERIFIED",
            "agentId": "urn:a2a:agent:example.com:financial-advisor:v2",
            "publicKey": {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo",
              "kid": "agent-a1b2c3d4"
            },
            "attestations": [
              {
                "type": "domain",
                "domain": "example.com",
                "verifiedAt": "2026-02-17T00:00:00Z",
                "method": "DNS_TXT"
              }
            ]
          }
        }
      ]
    }
  },
  "evidence": {
    "dnsTxt": {
      "recordName": "_a2a-identity.example.com",
      "recordValue": "v=a2a1; agent=financial-advisor; kid=agent-a1b2c3d4; fp=If4x36FUomFia_hUBG_SJxt77UtqvkWqWId-9H-XIbk"
    }
  },
  "expected": {
    "verifyResult": "REJECT",
    "rejectCategory": "SHAPE_INVALID"
  }
}
