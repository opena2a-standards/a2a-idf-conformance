{
  "$schema": "https://a2a-idf.opena2a.org/schemas/fixture-level-v1.json",
  "name": "levels/level-1-idn-provider-url",
  "description": "Level 1 (DOMAIN_VERIFIED) for an internationalized domain: provider.url is https://bücher.example, and every binding (attestation domain, agentId domain, DNS record name) uses its ASCII A-label xn--bcher-kva.example, the only form the agentId URN grammar and DNS admit. A conforming verifier derives the domain from provider.url in A-label form, as the WHATWG URL parser reports it, and ACCEPTs. A verifier that compares the Unicode host against the A-label bindings reports a spurious DOMAIN_MISMATCH.",
  "spec": [
    {
      "id": "A2A-IDF",
      "ref": "https://github.com/a2aproject/A2A/pull/1496",
      "section": "§1 Agent Identity Verification Levels — Level 1 DNS Verification (internationalized domain)"
    },
    {
      "id": "RFC 8032",
      "ref": "https://datatracker.ietf.org/doc/html/rfc8032",
      "section": "§7.1 (Ed25519 test keypairs)"
    },
    {
      "id": "WHATWG URL",
      "ref": "https://url.spec.whatwg.org/#concept-domain-to-ascii",
      "section": "domain to ASCII"
    }
  ],
  "level": 1,
  "agentCard": {
    "name": "financial-advisor-agent",
    "provider": {
      "organization": "Example Corp",
      "url": "https://bücher.example"
    },
    "capabilities": {
      "extensions": [
        {
          "uri": "https://a2a-protocol.org/extensions/agent-identity",
          "description": "Agent identity verification and trust signals",
          "required": false,
          "params": {
            "version": "1.0.0",
            "identityLevel": "DOMAIN_VERIFIED",
            "agentId": "urn:a2a:agent:xn--bcher-kva.example:financial-advisor:v2",
            "publicKey": {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo",
              "kid": "agent-a1b2c3d4"
            },
            "attestations": [
              {
                "type": "domain",
                "domain": "xn--bcher-kva.example",
                "verifiedAt": "2026-02-17T00:00:00Z",
                "method": "DNS_TXT"
              }
            ]
          }
        }
      ]
    }
  },
  "evidence": {
    "dnsTxt": {
      "recordName": "_a2a-identity.xn--bcher-kva.example",
      "recordValue": "v=a2a1; agent=financial-advisor; kid=agent-a1b2c3d4; fp=If4x36FUomFia_hUBG_SJxt77UtqvkWqWId-9H-XIbk"
    }
  },
  "expected": {
    "verifyResult": "ACCEPT"
  }
}
