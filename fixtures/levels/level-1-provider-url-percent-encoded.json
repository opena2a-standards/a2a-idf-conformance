{
  "$schema": "https://a2a-idf.opena2a.org/schemas/fixture-level-v1.json",
  "name": "levels/level-1-provider-url-percent-encoded",
  "description": "Level 1 (DOMAIN_VERIFIED) with a percent-encoded provider host: provider.url is https://ex%61mple.com, where %61 is the letter a. Every binding names example.com. A conforming verifier percent-decodes the host before using it as the provider domain, as the WHATWG URL parser does, and ACCEPTs. A verifier that keeps the host as written, or refuses the percent sign, rejects and fails this fixture.",
  "spec": [
    {
      "id": "A2A-IDF",
      "ref": "https://github.com/a2aproject/A2A/pull/1496",
      "section": "§1 Agent Identity Verification Levels — Level 1 DNS Verification (percent-encoded provider host)"
    },
    {
      "id": "RFC 8032",
      "ref": "https://datatracker.ietf.org/doc/html/rfc8032",
      "section": "§7.1 (Ed25519 test keypairs)"
    },
    {
      "id": "WHATWG URL",
      "ref": "https://url.spec.whatwg.org/",
      "section": "host parsing (percent-decoding of a domain)"
    }
  ],
  "level": 1,
  "agentCard": {
    "name": "financial-advisor-agent",
    "provider": {
      "organization": "Example Corp",
      "url": "https://ex%61mple.com"
    },
    "capabilities": {
      "extensions": [
        {
          "uri": "https://a2a-protocol.org/extensions/agent-identity",
          "description": "Agent identity verification and trust signals",
          "required": false,
          "params": {
            "version": "1.0.0",
            "identityLevel": "DOMAIN_VERIFIED",
            "agentId": "urn:a2a:agent:example.com:financial-advisor:v2",
            "publicKey": {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo",
              "kid": "agent-a1b2c3d4"
            },
            "attestations": [
              {
                "type": "domain",
                "domain": "example.com",
                "verifiedAt": "2026-02-17T00:00:00Z",
                "method": "DNS_TXT"
              }
            ]
          }
        }
      ]
    }
  },
  "evidence": {
    "dnsTxt": {
      "recordName": "_a2a-identity.example.com",
      "recordValue": "v=a2a1; agent=financial-advisor; kid=agent-a1b2c3d4; fp=If4x36FUomFia_hUBG_SJxt77UtqvkWqWId-9H-XIbk"
    }
  },
  "expected": {
    "verifyResult": "ACCEPT"
  }
}
