      "ref": "https://github.com/a2aproject/A2A/pull/1496",
      "section": "§1 Organization Verification (registry attestation)"
    },
    {
      "id": "RFC 8785",
      "ref": "https://datatracker.ietf.org/doc/html/rfc8785",
      "section": "JCS canonical form (attestation signing input)"
    },
    {
      "id": "RFC 8032",
      "ref": "https://datatracker.ietf.org/doc/html/rfc8032",
      "section": "§7.1 Test 1 (agent key), Test 2 (registry issuer key)"
    }
  ],
